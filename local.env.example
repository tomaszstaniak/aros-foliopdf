# Copy to local.env (not tracked). Environment variables already set win.
# Relative paths resolve from this file's directory.

# AROS_TARGET=one          # one (ABIv11, AROS One) or mainline (ABIv1)
# AROS_GCC_ROOT=/path/to/toolchain/bin     # holds x86_64-aros-gcc, -g++, -ar, -strip
# AROS_SDK=/path/to/Developer              # the SDK matching that toolchain
# AROS_BUILD_VOLUME=                       # only if the toolchain's linker path is hardcoded
